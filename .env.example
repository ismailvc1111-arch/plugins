# --- Strapi ---
APP_KEYS=replace-with-random1,replace-with-random2
API_TOKEN_SALT=replace-with-random3
ADMIN_JWT_SECRET=replace-with-random4
TRANSFER_TOKEN_SALT=replace-with-random5
JWT_SECRET=replace-with-random6
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aeat_invoicing
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
COMPANY_NAME={{company_name}}
COMPANY_TAX_ID={{company_tax_id}}
COMPANY_COUNTRY={{company_country}}
INVOICE_DEFAULT_SERIES={{series_format}}
INVOICE_DEFAULT_CURRENCY={{currency}}
DEFAULT_VAT={{iva}}
AEAT_P12_BASE64=
AEAT_P12_PASS=
AEAT_SII_WSDL={{wsdl_url}}
AEAT_SII_ENDPOINT={{endpoint_url}}
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REDIS_URL=

# --- Next.js ---
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY={{currency}}
STRAPI_API_TOKEN=
E2E_BASE_URL=http://localhost:3000
E2E_MOCK=1

# AEAT certificate variables are shared by backend and frontend server runtimes:
# AEAT_P12_BASE64 and AEAT_P12_PASS must contain the base64 encoded .p12 and its password.
