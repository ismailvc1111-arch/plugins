{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "taxId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "country": {
      "type": "string",
      "default": "ES"
    },
    "address": {
      "type": "text"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "series": {
      "type": "string",
      "default": "A"
    },
    "certAlias": {
      "type": "string"
    },
    "certNotAfter": {
      "type": "datetime"
    },
    "users": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "company"
    },
    "customers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::customer.customer",
      "mappedBy": "company"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "company"
    },
    "invoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice.invoice",
      "mappedBy": "company"
    }
  }
}
