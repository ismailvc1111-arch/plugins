{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "Customer"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "customers",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "taxId": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "string",
      "default": "ES"
    },
    "email": {
      "type": "email"
    },
    "address": {
      "type": "text"
    },
    "invoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice.invoice",
      "mappedBy": "customer"
    }
  }
}
